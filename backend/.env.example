LIBRENMS_URL=http://192.168.1.100
LIBRENMS_API_TOKEN=
REQUEST_TIMEOUT=10
CACHE_TTL=15
VERIFY_SSL=true
# Set true to serve illustrative mock data when LibreNMS is unreachable or not configured
MOCK_FALLBACK=false
# Comma-separated list of frontend origins. For testing from other PCs on your LAN add them,
# e.g. http://192.168.1.50:5173  (or * to allow any origin while testing)
CORS_ORIGINS=http://localhost:5173
